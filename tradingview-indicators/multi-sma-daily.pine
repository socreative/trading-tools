// This Pine Script(TM) is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Up to 5 Simple Moving Averages, always calculated on 1-day data, on any chart timeframe

//@version=6
// No shorttitle on purpose: the status line then shows the full name.
indicator("ExposureTrade - Multi SMA (Daily)", overlay=true, max_labels_count=500)

// --- Timeframe (fixed on purpose: these are always daily SMAs) ---
SMA_TF = "1D"

// When the chart is already daily or higher, calculate locally instead of requesting a
// lower timeframe, which would return misleading values on weekly/monthly charts.
useLocal = timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds(SMA_TF)

// --- Global inputs ---
grpGlobal   = "Global"
showLabels  = input.bool(true, "Show labels on last bar", group=grpGlobal, display=display.none)
labelOffset = input.int(5, "Label offset (bars)", minval=0, maxval=100, group=grpGlobal, display=display.none)
labelSizeIn = input.string("Small", "Label size", options=["Tiny", "Small", "Normal"], group=grpGlobal, display=display.none)

// --- Per-SMA inputs ---
// Color, thickness and line style are not here on purpose. They are plot properties, so the
// Style tab owns them, exactly as it does for the built-in Simple Moving Average.
g1 = "SMA 1"
show1 = input.bool(true,    "",       inline="1", group=g1, display=display.none)
len1  = input.int(20,       "Length", inline="1", group=g1, minval=1, maxval=5000, display=display.status_line)
src1  = input.source(close, "Source", inline="1", group=g1, display=display.none)
off1  = input.int(0,        "Offset", inline="1", group=g1, minval=-500, maxval=500, display=display.none)

g2 = "SMA 2"
show2 = input.bool(true,    "",       inline="2", group=g2, display=display.none)
len2  = input.int(50,       "Length", inline="2", group=g2, minval=1, maxval=5000, display=display.status_line)
src2  = input.source(close, "Source", inline="2", group=g2, display=display.none)
off2  = input.int(0,        "Offset", inline="2", group=g2, minval=-500, maxval=500, display=display.none)

g3 = "SMA 3"
show3 = input.bool(true,    "",       inline="3", group=g3, display=display.none)
len3  = input.int(100,      "Length", inline="3", group=g3, minval=1, maxval=5000, display=display.status_line)
src3  = input.source(close, "Source", inline="3", group=g3, display=display.none)
off3  = input.int(0,        "Offset", inline="3", group=g3, minval=-500, maxval=500, display=display.none)

g4 = "SMA 4"
show4 = input.bool(true,    "",       inline="4", group=g4, display=display.none)
len4  = input.int(200,      "Length", inline="4", group=g4, minval=1, maxval=5000, display=display.status_line)
src4  = input.source(close, "Source", inline="4", group=g4, display=display.none)
off4  = input.int(0,        "Offset", inline="4", group=g4, minval=-500, maxval=500, display=display.none)

g5 = "SMA 5"
show5 = input.bool(false,   "",       inline="5", group=g5, display=display.none)
len5  = input.int(10,       "Length", inline="5", group=g5, minval=1, maxval=5000, display=display.status_line)
src5  = input.source(close, "Source", inline="5", group=g5, display=display.none)
off5  = input.int(0,        "Offset", inline="5", group=g5, minval=-500, maxval=500, display=display.none)

// --- Request the daily SMAs ---
// Default lookahead_off with no historical offset: closed daily values on history, and a
// live-updating value for the day in progress. Same behaviour as the built-in SMA with its
// Timeframe field set to 1 day. Kept at the top level so every call runs on every bar.
d1 = request.security(syminfo.tickerid, SMA_TF, ta.sma(src1, len1))
d2 = request.security(syminfo.tickerid, SMA_TF, ta.sma(src2, len2))
d3 = request.security(syminfo.tickerid, SMA_TF, ta.sma(src3, len3))
d4 = request.security(syminfo.tickerid, SMA_TF, ta.sma(src4, len4))
d5 = request.security(syminfo.tickerid, SMA_TF, ta.sma(src5, len5))

sma1 = useLocal ? ta.sma(src1, len1) : d1
sma2 = useLocal ? ta.sma(src2, len2) : d2
sma3 = useLocal ? ta.sma(src3, len3) : d3
sma4 = useLocal ? ta.sma(src4, len4) : d4
sma5 = useLocal ? ta.sma(src5, len5) : d5

// --- Plots ---
// The color and linewidth passed here are defaults only. Anything the user sets in the Style
// tab wins, which is why neither is wired to an input: a value derived from an input is
// reapplied on every bar and would silently override the Style tab.
// display omits display.status_line so the status line stays as the indicator name plus the
// SMA lengths. Values remain in the price scale, the data window and the labels below.
PLOT_DISPLAY = display.pane + display.price_scale + display.data_window

plot(show1 ? sma1 : na, "SMA 1", color=color.blue,   linewidth=1, offset=off1, display=PLOT_DISPLAY)
plot(show2 ? sma2 : na, "SMA 2", color=color.orange, linewidth=1, offset=off2, display=PLOT_DISPLAY)
plot(show3 ? sma3 : na, "SMA 3", color=color.purple, linewidth=2, offset=off3, display=PLOT_DISPLAY)
plot(show4 ? sma4 : na, "SMA 4", color=color.red,    linewidth=2, offset=off4, display=PLOT_DISPLAY)
plot(show5 ? sma5 : na, "SMA 5", color=color.aqua,   linewidth=1, offset=off5, display=PLOT_DISPLAY)

// --- Labels on the last bar ---
labelSize = labelSizeIn == "Tiny" ? size.tiny : labelSizeIn == "Normal" ? size.normal : size.small
// Names the timeframe the values actually came from: "1D" normally, or the chart timeframe
// on daily-and-above charts where the SMA is calculated locally.
tfSuffix  = useLocal ? timeframe.period : "1D"
// A script cannot read the colors the user picked in the Style tab, so labels use the chart
// foreground color, which follows the light or dark theme. The length in the text identifies
// which line each label belongs to.
labelColor = chart.fg_color

var label lb1 = na
var label lb2 = na
var label lb3 = na
var label lb4 = na
var label lb5 = na

if barstate.islast
    label.delete(lb1)
    label.delete(lb2)
    label.delete(lb3)
    label.delete(lb4)
    label.delete(lb5)

    if showLabels
        if show1 and not na(sma1)
            lb1 := label.new(bar_index + labelOffset + off1, sma1, "SMA " + str.tostring(len1) + " (" + tfSuffix + ")  " + str.tostring(sma1, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=labelColor, size=labelSize)
        if show2 and not na(sma2)
            lb2 := label.new(bar_index + labelOffset + off2, sma2, "SMA " + str.tostring(len2) + " (" + tfSuffix + ")  " + str.tostring(sma2, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=labelColor, size=labelSize)
        if show3 and not na(sma3)
            lb3 := label.new(bar_index + labelOffset + off3, sma3, "SMA " + str.tostring(len3) + " (" + tfSuffix + ")  " + str.tostring(sma3, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=labelColor, size=labelSize)
        if show4 and not na(sma4)
            lb4 := label.new(bar_index + labelOffset + off4, sma4, "SMA " + str.tostring(len4) + " (" + tfSuffix + ")  " + str.tostring(sma4, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=labelColor, size=labelSize)
        if show5 and not na(sma5)
            lb5 := label.new(bar_index + labelOffset + off5, sma5, "SMA " + str.tostring(len5) + " (" + tfSuffix + ")  " + str.tostring(sma5, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=labelColor, size=labelSize)
